<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Walk.Neighborhood}}{{with .Walk.City}}, {{.}}{{end}} · Bairro em Ação</title>
<style>
  :root { --ink: #1c2420; --muted: #5b6660; --line: #dfe5e1; --paper: #fbfcfa; --accent: #1f6f4a; --soft: #e8f2ec; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 760px; margin: 0 auto; padding: 40px 20px 64px; }
  .kicker { color: var(--accent); font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  h1 { font-size: 34px; line-height: 1.15; margin: 6px 0 8px; letter-spacing: -.01em; }
  .meta { color: var(--muted); margin: 0; }
  .summary { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 8px; padding: 0; list-style: none; }
  .summary li { background: var(--soft); color: var(--accent); border-radius: 999px; padding: 4px 12px; font-size: 14px; font-weight: 600; }
  h2 { font-size: 20px; margin: 40px 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--line); display: flex; justify-content: space-between; align-items: baseline; }
  h2 small { color: var(--muted); font-weight: 500; font-size: 14px; }
  article { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); break-inside: avoid; }
  article img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; background: var(--line); display: block; }
  article .nophoto { aspect-ratio: 4 / 3; border-radius: 10px; background: var(--line); }
  h3 { margin: 0 0 4px; font-size: 17px; line-height: 1.3; }
  article p { margin: 0 0 8px; }
  .details { color: var(--muted); font-size: 14px; margin: 0; }
  .details a { color: var(--accent); }
  .note { font-size: 14px; color: var(--muted); border-left: 3px solid var(--line); padding-left: 10px; font-style: italic; }
  .empty { margin-top: 32px; color: var(--muted); }
  .map { margin-top: 28px; }
  .map h2 { margin-top: 0; }
  .map svg { display: block; width: 100%; height: auto; border-radius: 12px; background: #e9ede7; }
  .map .attribution { color: var(--muted); font-size: 13px; margin: 6px 0 0; text-align: right; }
  .map .attribution a { color: inherit; }
  .num { display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 6px; margin-right: 6px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 13px; vertical-align: 2px; }
  footer { margin-top: 40px; color: var(--muted); font-size: 13px; }
  footer p { margin: 0 0 6px; }
  @media (max-width: 560px) { article { grid-template-columns: 1fr; } h1 { font-size: 28px; } }
  @media print { body { background: #fff; } main { padding: 0; } a { color: inherit; } }
</style>
</head>
<body>
<main>
  <p class="kicker">Relatório de caminhada · Bairro em Ação</p>
  <h1>{{.Walk.Neighborhood}}</h1>
  <p class="meta">
    {{with .Walk.City}}{{.}}{{with $.Walk.State}}/{{.}}{{end}} · {{end}}{{date .Walk.StartedAt}}, das {{clock .Walk.StartedAt}}{{with .Walk.FinishedAt}} às {{clock .}}{{end}}{{with duration .Walk}} ({{.}}){{end}}
    {{if gt .Distance 0.0}}· {{distance .Distance}} percorridos{{end}}
    · {{.Confirmed}} {{plural .Confirmed "problema registrado" "problemas registrados"}}
  </p>
  {{if .Sections}}
  <ul class="summary">
    {{range .Sections}}<li>{{.Label}}: {{len .Items}}</li>{{end}}
  </ul>
  {{with .Map}}
  <section class="map">
    <h2>Trajeto{{if gt $.Distance 0.0}} <small>{{distance $.Distance}}</small>{{end}}</h2>
    <svg viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="Mapa do trajeto com os pontos numerados">
      {{range .Tiles}}<image href="{{.Src}}" x="{{.X}}" y="{{.Y}}" width="256" height="256"/>{{end}}
      {{with .Route}}<polyline points="{{.}}" fill="none" stroke="#ffffff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
      <polyline points="{{.}}" fill="none" stroke="#1f6f4a" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/>{{end}}
      {{with .Start}}<circle cx="{{.X}}" cy="{{.Y}}" r="7" fill="#ffffff" stroke="#1f6f4a" stroke-width="3.5"><title>Início</title></circle>{{end}}
      {{range .Markers}}{{if .Spread}}<line x1="{{.AnchorX}}" y1="{{.AnchorY}}" x2="{{.X}}" y2="{{.Y}}" stroke="#1c2420" stroke-width="2"/><circle cx="{{.AnchorX}}" cy="{{.AnchorY}}" r="3.5" fill="#1c2420" stroke="#ffffff" stroke-width="1.5"/>{{end}}{{end}}
      {{range .Markers}}<g transform="translate({{.X}} {{.Y}})"><circle r="15" fill="{{.Color}}" stroke="#ffffff" stroke-width="3.5"/><text text-anchor="middle" dy="5" fill="#ffffff" font-size="15" font-weight="700" font-family="system-ui, sans-serif">{{.Number}}</text></g>{{end}}
    </svg>
    <p class="attribution"><a href="{{.OpenURL}}">Abrir mapa interativo (com zoom)</a>{{with .Attribution}} · Mapa: <a href="https://www.openstreetmap.org/copyright">{{.}}</a>{{end}}</p>
  </section>
  {{end}}
  {{range .Sections}}
  <h2>{{.Label}} <small>{{len .Items}} {{plural (len .Items) "ponto" "pontos"}}</small></h2>
  {{range .Items}}
  <article>
    {{with photo .Photo}}<img src="{{.}}" alt="Foto do problema registrado">{{else}}<div class="nophoto"></div>{{end}}
    <div>
      <h3><span class="num">{{.Number}}</span>{{.Title}}</h3>
      {{with .Description}}<p>{{.}}</p>{{end}}
      {{with .Note}}<p class="note">Relato de quem caminhou: {{.}}</p>{{end}}
      <p class="details">
        Registrado às {{clock .CapturedAt}}
        {{with .Location}} · <a href="{{mapURL .}}">{{coords .}}</a>{{with .Accuracy}} ({{meters .}}){{end}}{{else}} · sem localização{{end}}
      </p>
    </div>
  </article>
  {{end}}
  {{end}}
  {{else}}
  <p class="empty">Nenhum ponto foi confirmado nesta caminhada ainda.</p>
  {{end}}
  <footer>
    <p>Fotos, horários e localizações foram registrados pelo aplicativo durante a caminhada.{{if .Models}} Categoria, título e descrição foram sugeridos por um modelo de IA aberto ({{join .Models ", "}}) rodando localmente e revisados por quem caminhou.{{end}}</p>
    {{if .AICompared}}<p>A categoria sugerida pela IA foi mantida em {{.AIMatched}} de {{.AICompared}} {{plural .AICompared "registro" "registros"}} ({{percent .AIMatched .AICompared}}%).</p>{{end}}
    {{if lt .Confirmed .Recorded}}<p>{{.Recorded}} pontos foram registrados; este relatório inclui os {{.Confirmed}} revisados.</p>{{end}}
  </footer>
</main>
</body>
</html>
