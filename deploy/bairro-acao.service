# Serviço de usuário (sem sudo) que mantém o servidor do celular ligado e o
# inicia junto com a sessão. Instalação:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/bairro-acao.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now bairro-acao
# Ajuste WorkingDirectory se o projeto estiver em outro lugar.
[Unit]
Description=Bairro em Ação (servidor para o celular)
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/dev/hacktoberfest/bairro-acao
ExecStart=%h/dev/hacktoberfest/bairro-acao/scripts/servidor-celular.sh
Restart=on-failure
RestartSec=10
# go, npm and ollama are usually in the login shell's PATH only.
Environment=PATH=%h/.local/share/mise/shims:%h/.nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
