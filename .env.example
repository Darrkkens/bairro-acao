# The backend loads ./.env or ../.env automatically on start; variables already set in the shell win.
API_ADDR=127.0.0.1:8090
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL (docker compose up -d). Required.
POSTGRES_DB=bairro_acao
POSTGRES_USER=bairro_acao
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5436
DATABASE_URL=postgres://bairro_acao:change-me@127.0.0.1:5436/bairro_acao?sslmode=disable

# Photo files; the database keeps only their names. Relative to where the backend runs.
PHOTOS_DIR=data/photos

# Open-weight vision model served locally by Ollama (ollama pull gemma3:4b).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# CPU-only or small GPUs can take a minute or more per photo.
OLLAMA_TIMEOUT=300s

# Time zone used for dates in the downloadable report.
REPORT_TIMEZONE=America/Sao_Paulo

# Static route map in the downloadable report. Tiles are cached in TILE_CACHE_DIR.
# Use your own tile server for heavy use, or "off" to draw only the route.
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors
TILE_CACHE_DIR=data/tiles

# Frontend (put in frontend/.env.local): city every walk starts with. Detection fills
# the neighborhood there and only offers another city, never switches by itself.
# VITE_DEFAULT_CITY=Joaçaba
# VITE_DEFAULT_STATE=SC
